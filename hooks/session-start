#!/bin/bash
# Designpowers session-start hook
# Tells the session to invoke the using-designpowers skill via the normal
# Skill mechanism, instead of pasting the whole skill file into context.
#
# Previously this injected the entire using-designpowers/SKILL.md
# (~192 lines, ~10.8KB, ~2,700+ tokens) as a raw message on every session
# start — permanently on the desk, every session, whether or not the work
# that follows is design-related. The skill itself is fetched on demand by
# the Skill tool when actually invoked, so pre-pasting its content here was
# pure duplication: the desk, when the whole point of a skill is to be the
# phone. This hook now sends a one-line instruction instead and lets the
# normal skill-loading path do the fetching.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

SKILL_FILE="$PLUGIN_ROOT/skills/using-designpowers/SKILL.md"

if [ ! -f "$SKILL_FILE" ]; then
  echo "Warning: using-designpowers skill not found at $SKILL_FILE" >&2
  exit 0
fi

TRIGGER="EXTREMELY_IMPORTANT: Before responding to any user message this session, invoke the using-designpowers skill via the Skill tool. Do not skip it, do not answer first, do not paraphrase it from memory — invoke it so its current content loads."

if [ -n "$CURSOR_SESSION" ]; then
  cat <<EOF
{
  "role": "system",
  "content": "${TRIGGER}"
}
EOF
else
  cat <<EOF
{
  "role": "user",
  "content": "${TRIGGER}"
}
EOF
fi
