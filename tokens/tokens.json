{
  "$description": "Color tokens exported from the live source of truth. Generated by reading my-app/src/styles/App.css directly — not hand-typed. This is the canonical token file: edit App.css's :root blocks first, then re-export, never the reverse.",
  "$extensions": {
    "com.designpowers.source": "my-app/src/styles/App.css",
    "com.designpowers.sourceLines": "light: L14-84, dark: L88-136",
    "com.designpowers.freshness": "2026-08-27",
    "com.designpowers.scope": "Covers the canonical :root palette only. Does NOT cover the ~150 additional one-off hex values used for Riso-piece illustration/gradient work in riso-page.css — those are art direction, not reusable system tokens, and are intentionally excluded (see drift-audit.md)."
  },
  "color": {
    "global": {
      "$description": "Raw palette values. Named by what they are, not what they do. Never reference these directly in component CSS — go through color.semantic.",
      "olive": {
        "1": { "$type": "color", "$value": "#7c8c3c", "$description": "Source: App.css:21 (--olive-1)" },
        "2": { "$type": "color", "$value": "#5a7a2e", "$description": "Source: App.css:22 (--olive-2)" },
        "3": { "$type": "color", "$value": "#3d5a1e", "$description": "Source: App.css:23 (--olive-3)" }
      },
      "accent-warm": { "$type": "color", "$value": "#946420", "$description": "Source: App.css:24. Darkened from #b87d35 to clear WCAG AA (4.5:1) at body size on the light bg — do not lighten without re-checking contrast." },
      "cream": { "$type": "color", "$value": "#faf9f7", "$description": "Source: App.css:16 (--bg)" },
      "ink": { "$type": "color", "$value": "#0a0a0a", "$description": "Source: App.css:17 (--fg)" },
      "taupe": { "$type": "color", "$value": "#6b6560", "$description": "Source: App.css:18 (--muted)" },
      "card-cream": { "$type": "color", "$value": "#f5f3f0", "$description": "Source: App.css:19 (--card)" }
    },
    "semantic": {
      "$description": "Map global tokens to roles. Component CSS should reference these, via var(), never a literal hex.",
      "light": {
        "bg": { "$type": "color", "$value": "{color.global.cream}" },
        "fg": { "$type": "color", "$value": "{color.global.ink}" },
        "muted": { "$type": "color", "$value": "{color.global.taupe}" },
        "card": { "$type": "color", "$value": "{color.global.card-cream}" },
        "border": { "$type": "color", "$value": "rgba(0, 0, 0, 0.08)" },
        "border-strong": { "$type": "color", "$value": "color-mix(in srgb, {color.semantic.light.fg} 14%, transparent)" },
        "accent-warm": { "$type": "color", "$value": "{color.global.accent-warm}" },
        "focus": { "$type": "color", "$value": "{color.global.olive.2}" },
        "surface-0": { "$type": "color", "$value": "{color.semantic.light.bg}" },
        "surface-1": { "$type": "color", "$value": "{color.semantic.light.card}" },
        "surface-2": { "$type": "color", "$value": "#faf9f7", "$description": "Source: App.css:30 — literally equal to --bg; kept distinct in source for future divergence." },
        "text-1": { "$type": "color", "$value": "{color.semantic.light.fg}" },
        "text-2": { "$type": "color", "$value": "color-mix(in srgb, {color.semantic.light.fg} 72%, transparent)" },
        "text-3": { "$type": "color", "$value": "{color.semantic.light.muted}" },
        "footer-icon-bg": { "$type": "color", "$value": "#ffffff" },
        "footer-icon-border": { "$type": "color", "$value": "#d0d5dd" },
        "footer-icon-color": { "$type": "color", "$value": "#344054" },
        "footer-icon-hover-bg": { "$type": "color", "$value": "#0a66c2" },
        "footer-icon-hover-color": { "$type": "color", "$value": "#ffffff" }
      },
      "dark": {
        "bg": { "$type": "color", "$value": "#15120c", "$description": "Source: App.css:94. Not derived from a global — dark palette is hand-tuned, not a mechanical inversion." },
        "fg": { "$type": "color", "$value": "#f5efe6", "$description": "Source: App.css:95" },
        "muted": { "$type": "color", "$value": "#b3a89a", "$description": "Source: App.css:96" },
        "card": { "$type": "color", "$value": "#231d14", "$description": "Source: App.css:97" },
        "border": { "$type": "color", "$value": "rgba(245, 239, 230, 0.14)" },
        "border-strong": { "$type": "color", "$value": "rgba(248, 210, 183, 0.26)" },
        "olive-1": { "$type": "color", "$value": "#f0d3a4", "$description": "Source: App.css:99 — dark-mode olive is a warm gold, not a lightened olive." },
        "olive-2": { "$type": "color", "$value": "#d9a55e", "$description": "Source: App.css:100" },
        "olive-3": { "$type": "color", "$value": "#b8823f", "$description": "Source: App.css:101" },
        "accent-warm": { "$type": "color", "$value": "#e8b06a", "$description": "Source: App.css:102" },
        "focus": { "$type": "color", "$value": "#e8b06a", "$description": "Source: App.css:103" },
        "on-accent": { "$type": "color", "$value": "#1a0e03", "$description": "Source: App.css:123. Text color used on accent backgrounds for WCAG contrast." },
        "surface-0": { "$type": "color", "$value": "#15120c" },
        "surface-1": { "$type": "color", "$value": "#231d14" },
        "surface-2": { "$type": "color", "$value": "#2e261a" },
        "text-1": { "$type": "color", "$value": "rgba(248, 210, 183, 0.96)" },
        "text-2": { "$type": "color", "$value": "rgba(248, 210, 183, 0.86)" },
        "text-3": { "$type": "color", "$value": "rgba(248, 210, 183, 0.76)" },
        "footer-icon-bg": { "$type": "color", "$value": "#161b22" },
        "footer-icon-border": { "$type": "color", "$value": "#30363d" },
        "footer-icon-color": { "$type": "color", "$value": "#e6edf3" },
        "footer-icon-hover-bg": { "$type": "color", "$value": "#0a66c2" },
        "footer-icon-hover-color": { "$type": "color", "$value": "#ffffff" }
      }
    }
  }
}
