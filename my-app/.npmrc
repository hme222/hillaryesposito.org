# react-scripts@5.0.1 declares `peerOptional typescript@"^3.2.1 || ^4"`. That cap is
# stale: CRA's actual type-checker (fork-ts-checker-webpack-plugin) accepts
# `typescript@">= 2.7"`, and TypeScript 5 builds and type-checks this project cleanly.
#
# TypeScript 5 is required here, not optional. @types/three@0.185 ships declaration
# files using TS5-only syntax that TS 4.9 cannot parse, which is what silently broke
# `npx tsc --noEmit` for this repo — the build kept reporting "Compiled successfully"
# while the type-check gate was dead.
#
# Without this flag npm refuses the install on that stale peer range. Recording it here
# so `npm install` works the same way for everyone instead of depending on remembering
# to pass --legacy-peer-deps.
legacy-peer-deps=true
