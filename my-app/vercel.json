{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "buildCommand": "npm run build && node ../scripts/prerender-routes.mjs && node ../scripts/verify-route-shell-parity.mjs",
  "outputDirectory": "build",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
